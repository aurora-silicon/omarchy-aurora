#!/bin/bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
[[ $(id -u) == 0 && $(uname -m) == aarch64 ]]
cd "$root"
python3 - <<'PYSPACE'
import shutil
if shutil.disk_usage('/var/tmp').free < 13*(1<<30):
    raise SystemExit('Package build needs 5 GiB peak plus the 8 GiB free floor')
PYSPACE
python3 inputs/alarm/scripts/fetch-base.py
stage=$(mktemp -d /var/tmp/omarchy-package-root.XXXXXX)
cleanup() {
  local status=$?
  local clean=1
  python3 inputs/alarm/scripts/stop-image-key-agents.py "$stage" || status=1
  for path in run sys proc dev ''; do
    if mountpoint -q "$stage${path:+/$path}"; then umount -R "$stage${path:+/$path}" || clean=0; fi
  done
  if (( clean == 1 )); then
    rm -rf -- "$stage"
  else
    echo "Preserving mounted package root at $stage for recovery" >&2
    status=1
  fi
  exit "$status"
}
trap cleanup EXIT
bsdtar --exclude='dev/*' -xpf inputs/alarm/cache/base/ArchLinuxARM-aarch64.tar.gz -C "$stage"
# Pacman downloads as its unprivileged alpm user inside this root.
chmod 0755 "$stage"
mount --bind "$stage" "$stage"
mkdir -p "$stage"/{dev,proc,sys,run,build,output}
mount --rbind /dev "$stage/dev"
mount --make-rslave "$stage/dev"
mount -t proc proc "$stage/proc"
mount --rbind /sys "$stage/sys"
mount --make-rslave "$stage/sys"
mount -t tmpfs tmpfs "$stage/run"
rm -f -- "$stage/etc/resolv.conf"
cp -L /etc/resolv.conf "$stage/etc/resolv.conf"
chroot "$stage" pacman-key --init
chroot "$stage" pacman-key --populate archlinuxarm
chroot "$stage" pacman -Syu --noconfirm --needed base-devel git imagemagick python systemd jq \
  lua python-yaml nodejs npm ripgrep shellcheck ffmpeg kitty gum plocate openssh unzip bc \
  libarchive libxkbcommon desktop-file-utils glib2 sqlite dtc
sed -i 's/^#\(en_US\.UTF-8 UTF-8\)/\1/' "$stage/etc/locale.gen"
chroot "$stage" locale-gen
chroot "$stage" useradd -m builder
cp -a inputs/runtime "$stage/build/runtime"
cp -a inputs/mac "$stage/build/mac"
mkdir "$stage/build/aurora"
cp -a overlay packages sources.lock.json LICENSE "$stage/build/aurora/"
builder_uid=$(chroot "$stage" id -u builder)
builder_gid=$(chroot "$stage" id -g builder)
chown -R "$builder_uid:$builder_gid" "$stage/build" "$stage/output"
# Fedora exports container=oci; upstream fixtures use that name for their
# synthetic iBoot container path. Do not inject the host value into the suite.
chroot "$stage" runuser -u builder -- env -u container OMARCHY_TEST_RUNTIME=/build/runtime \
  bash -euo pipefail -c 'cd /build/mac; omarchy-mac/test/all; test/integration/all'
python3 scripts/prepare-runtime.py "$stage/build/runtime"
mkdir -p out/packages
for name in omarchy-settings omarchy omarchy-mac omarchy-aurora; do
  chroot "$stage" runuser -u builder -- env \
    OMARCHY_SRC=/build/runtime OMARCHY_MAC_SOURCE=/build/mac OMARCHY_AURORA_SOURCE=/build/aurora \
    bash -c 'cd "/build/aurora/packages/$1"; PKGDEST=/output makepkg --nodeps --noconfirm' build "$name"
done
cp "$stage"/output/*.pkg.tar.* out/packages/
python3 scripts/check-packages.py out/packages

python3 - <<'PYVALIDATION'
from pathlib import Path
import hashlib,json
lock=Path('sources.lock.json').read_bytes();data=json.loads(lock)
Path('out/package-validation.json').write_text(json.dumps({
  'schema':1,'mac_unit_suite':True,'mac_integration_suite':True,
  'sources_lock_sha256':hashlib.sha256(lock).hexdigest(),
  'mac_source':data['omarchy_mac']['commit'],'runtime_source':data['omarchy']['commit']},indent=2)+'\n')
PYVALIDATION
